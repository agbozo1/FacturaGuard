# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
# Regional endpoint from the Nebius cookbook. Check that it matches your key's region.
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model IDs are opaque strings. Run scripts/smoke_nebius.py --list to see what your key can use.
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_BALANCED=nvidia/nemotron-3-super-120b-a12b
MODEL_VISION=nvidia/nemotron-3-nano-omni

LLM_TIMEOUT_SECONDS=60
