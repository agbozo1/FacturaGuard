# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
# Regional endpoint from the Nebius cookbook. Check that it matches your key's region.
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model IDs are opaque strings. Run scripts/smoke_nebius.py --list to see what your key can use.
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_BALANCED=nvidia/nemotron-3-super-120b-a12b
# Leave empty unless your key lists a vision model (nemotron-3-nano-omni was not listed).
MODEL_VISION=

LLM_TIMEOUT_SECONDS=60

# Optional JSON merged into every request, e.g. {"chat_template_kwargs": {"enable_thinking": false}}
# Unverified for Token Factory. Test with scripts/smoke_nebius.py --extra-body '<json>'.
LLM_EXTRA_BODY=
# Extra body for the fast role only. Default switches off Lightning's thinking (verified).
# Set to an empty value to allow thinking.
LLM_EXTRA_BODY_FAST={"chat_template_kwargs": {"enable_thinking": false}}

# Optional. Tavily web search over official sources (anaf.ro, mfinante.gov.ro,
# legislatie.just.ro) for the assistant and the rule-update check. Keys start with tvly-.
TAVILY_API_KEY=
